# Write a function check_password(password) that returns "Strong" if the password is at least 8 characters AND contains at least one digit, otherwise "Weak"
#-------------Code------------------
def check_password(password):
    has_digit = any(char.isdigit() for char in password)
    if len(password) >= 8 and has_digit:
        return "Strong"
    else:
        return "Weak"

print(check_password("abc123def"))
print(check_password("abcdef"))
